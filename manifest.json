{
  "manifest_version": 3,
  "name": "Smart Form Autofill",
  "version": "2.0",
  "description": "Intelligent form autofill with fuzzy matching - fully local, no API calls",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo16.png",
      "32": "logo32.png",
      "48": "logo48.png",
      "128": "logo128.png"
    }
  },
  "icons": {
    "16": "logo16.png",
    "32": "logo32.png",
    "48": "logo48.png",
    "128": "logo128.png"
  }
}